  "posts": [
    { "id": "B-MOCK-001", "treeId": "JS0155103034", "date": "2026-10-20", "nickname": "匿名樹友", "text": "看到公告了，說明會那天我會去。" },
    { "id": "B-MOCK-002", "treeId": "JS0155103034", "date": "2026-10-21", "nickname": "早起散步的松鼠（模擬）", "text": "步道整修可以繞過祂嗎？這棵樹的樹蔭很大，夏天大家都在這裡乘涼。" },
    { "id": "B-MOCK-003", "treeId": "JS0155103034", "date": "2026-10-21", "nickname": "匿名樹友", "text": "我小時候也給祂做過契子，已經分享給家人了。" },
    { "id": "B-MOCK-004", "treeId": "JS0155100001", "date": "2026-10-12", "nickname": "樹下吃便當的上班族（模擬）", "text": "中午來這邊吃飯，茄苳仔今天也很有精神。" },
    { "id": "B-MOCK-005", "treeId": "JS0155100001", "date": "2026-10-19", "nickname": "匿名樹友", "text": "有人知道茄苳的果子可以吃嗎？" },
    { "id": "B-MOCK-006", "treeId": "JS0155503095", "date": "2026-10-16", "nickname": "賞鳥的小學生家長（模擬）", "text": "根部好像拱起來了，有懂樹的人可以來幫忙看看嗎？" },
    { "id": "B-MOCK-007", "treeId": "JS0155503095", "date": "2026-10-17", "nickname": "匿名樹友", "text": "雀榕一年會換好幾次葉，葉子稀可能是在換葉，不過根的部分還是值得通報。" },
    { "id": "B-MOCK-008", "treeId": "DA0215000020", "date": "2026-11-17", "nickname": "匿名樹友", "text": "看到公告了，說明會那天我會去。" },
    { "id": "B-MOCK-009", "treeId": "DA0215000020", "date": "2026-11-18", "nickname": "公園慢跑的人（模擬）", "text": "步道可以繞過祂嗎？夏天大家都在這棵樹下乘涼。" },
    { "id": "B-MOCK-010", "treeId": "JJ0060331065", "date": "2026-11-11", "nickname": "等公車的上班族（模擬）", "text": "每天在祂底下等車，今天第一次知道祂是茄苳。" },
